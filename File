				Color    = Properties.Color or Library.Theme.DimText,
				RichText = (Properties.RichText == true),
				Align    = Properties.Alignment or Properties.Align or Enum.TextXAlignment.Left,
				Height   = Properties.Height or Properties.Size or 15, -- row height
			}

			-- Parent to the chosen side
			local Holder = Instance.new("Frame", (Options.Side == "Right" and Label.Section.Elements.Right or Label.Section.Elements.Left))
			local Text   = Instance.new("TextLabel", Holder)

			-- participate in Library:SetOpen() fade
