			Icon.Name = "Icon"
			Icon:SetAttribute("CrimsonNoTheme", true)
			Sat:SetAttribute("CrimsonNoTheme", true)
			Hue:SetAttribute("CrimsonNoTheme", true)
			Icon.Position = UDim2.new(1, -30 - (count * 15) - (count * 6),0,4)
			Icon.Size = UDim2.new(0,15,0,6)
			Icon.BackgroundColor3 = default
			Icon.BorderColor3 = Library.Theme.Outline
			Icon.AutoButtonColor = false
			Icon.Text = ""
			--
			Gradient.Name = "Gradient"
			Gradient.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(
					0,
					Color3.new(0.7803921699523926, 0.7490196228027344, 0.800000011920929)	
				),
				ColorSequenceKeypoint.new(
					1,
					Color3.new(1, 1, 1)	
				)
			}
			Gradient.Rotation = -90
