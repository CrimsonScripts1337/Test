			Text.RichText = Label.RichText
			Text.TextWrapped = true
			Text.TextTruncate = Enum.TextTruncate.None

			-- Methods
			function Label:Set(newText)
				self.Text = tostring(newText or "")
				Text.Text = self.Text
			end
			function Label:SetText(newText) -- alias
				Label:Set(newText)
			end
			function Label:SetColor(color)
				self.Color = color
				Text.TextColor3 = color
			end
			function Label:SetAlignment(align)
				self.Align = align
				Text.TextXAlignment = align
			end
			function Label:SetRichText(on)
				self.RichText = (on and true or false)
				Text.RichText = self.RichText
			end
			function Label:SetVisible(on)
				Holder.Visible = (on ~= false)
			end
			function Label:Destroy()
				Holder:Destroy()
			end

			return Label
		end
