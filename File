		-- which transparency properties each class fades
		local FadeProps = {
			Frame = {"BackgroundTransparency"},
			ScrollingFrame = {"BackgroundTransparency", "ScrollBarImageTransparency"},
			TextLabel = {"BackgroundTransparency", "TextTransparency"},
			TextButton = {"BackgroundTransparency", "TextTransparency"},
			TextBox = {"BackgroundTransparency", "TextTransparency"},
			ImageLabel = {"BackgroundTransparency", "ImageTransparency"},
			ImageButton = {"BackgroundTransparency", "ImageTransparency"},
			UIStroke = {"Transparency"},
		}
		local FadeTime = 0.25
		--
		-- Sets a transparency property in a fade-safe way. While the UI is faded out
		-- the real value is stored and applied when the UI fades back in.
		function Library:SetTransparency(Inst, Property, Value)
			local Cache = Library.FadeCache[Inst]
			if Cache and Cache[Property] ~= nil then
				Cache[Property] = Value
				if Library.Open then
					-- fading in right now: retarget the running tween
					TweenService:Create(Inst, TweenInfo.new(0.1), {[Property] = Value}):Play()
				end
			else
				Inst[Property] = Value
			end
		end
		--
		function Library:SetOpen(bool)
			if typeof(bool) ~= 'boolean' then
				return
			end

			Library.Open = bool
			Library.FadeToken += 1
			local Token = Library.FadeToken
			local Info = TweenInfo.new(FadeTime, Enum.EasingStyle.Linear, bool and Enum.EasingDirection.Out or Enum.EasingDirection.In)

			if bool then
				Library.Holder.Visible = true
			else
				Library:ClosePopups()
			end

			for _, v in next, Library.Instances do
				local Props = typeof(v) == "Instance" and v.Parent and FadeProps[v.ClassName]
				if Props then
					local Cache = Library.FadeCache[v]

					-- Snapshot the real values the first time we fade out. If a fade is
					-- already in progress the snapshot is kept, so a half-faded value is
					-- never mistaken for the real one.
					if not bool and not Cache then
						Cache = {}
						for _, Prop in ipairs(Props) do
							Cache[Prop] = v[Prop]
						end
						Library.FadeCache[v] = Cache
					end

					if Cache then
						local Goal = {}
						for Prop, Real in next, Cache do
							if Real < 1 then
								Goal[Prop] = bool and Real or 1
							end
						end
						if next(Goal) then
							TweenService:Create(v, Info, Goal):Play()
						end
					end
				end
			end

			task.delay(FadeTime, function()
				if Library.FadeToken ~= Token then
					return -- toggled again before this fade finished
				end
				if bool then
					table.clear(Library.FadeCache)
				else
					Library.Holder.Visible = false
				end
			end)

			task.spawn(function()
				TweenService:Create(Library.PageHolder, TweenInfo.new(FadeTime, Enum.EasingStyle.Quad, bool and Enum.EasingDirection.Out or Enum.EasingDirection.In), {Position = bool and UDim2.new(0,60,0,0) or UDim2.new(0,0,0,0)}):Play()
				--
				if bool then
					task.wait(0.05)
				end
				TweenService:Create(Library.Gradient, TweenInfo.new(FadeTime, Enum.EasingStyle.Quad, bool and Enum.EasingDirection.Out or Enum.EasingDirection.In), {Position = bool and UDim2.new(0.5,0,0,2) or UDim2.new(1,0,0,2)}):Play()
				TweenService:Create(Library.Gradient, TweenInfo.new(FadeTime, Enum.EasingStyle.Quad, bool and Enum.EasingDirection.Out or Enum.EasingDirection.In), {Size = bool and UDim2.new(0.5,0,0,1) or UDim2.new(0,0,0,1)}):Play()
			end)
		end;
		--
		-- Is a gui actually on screen (it and every ancestor visible)?
		local function IsShown(Gui)
			local Current = Gui
			while Current and not Current:IsA("LayerCollector") do
				if Current:IsA("GuiObject") and not Current.Visible then
					return false
				end
				Current = Current.Parent
			end
			return Current ~= nil
		end
		--
		-- Is the anchor still inside the visible area of the scrolling frame holding it?
		local function InViewport(Gui)
			local Scroller = Gui:FindFirstAncestorWhichIsA("ScrollingFrame")
			if not Scroller then
				return true
			end
			local Center = Gui.AbsolutePosition.Y + Gui.AbsoluteSize.Y / 2
			local Top = Scroller.AbsolutePosition.Y
			return Center >= Top and Center <= Top + Scroller.AbsoluteSize.Y
		end
		--
		-- Dropdown lists and colorpicker windows live inside the element rows, which
		-- now sit in a ScrollingFrame (that always clips). While open, the popup is
		-- moved to an overlay layer and kept pinned to its anchor.
		function Library:RegisterPopup(Popup, Anchor)
			local Home = Popup.Parent
			local BasePosition, BaseSize = Popup.Position, Popup.Size
			local Follow

			local function Place()
				local Overlay = Library.Overlay
				local AnchorPos, AnchorSize = Anchor.AbsolutePosition, Anchor.AbsoluteSize
				local OverlayPos = Overlay.AbsolutePosition
				Popup.Position = UDim2.fromOffset(
					AnchorPos.X - OverlayPos.X + BasePosition.X.Scale * AnchorSize.X + BasePosition.X.Offset,
					AnchorPos.Y - OverlayPos.Y + BasePosition.Y.Scale * AnchorSize.Y + BasePosition.Y.Offset
				)
				Popup.Size = UDim2.fromOffset(
					BaseSize.X.Scale * AnchorSize.X + BaseSize.X.Offset,
					BaseSize.Y.Scale * AnchorSize.Y + BaseSize.Y.Offset
				)
			end

			local function Restore()
				if Follow then
					Follow:Disconnect()
					Follow = nil
				end
				if Home and Home.Parent then
					Popup.Parent = Home
				end
				Popup.Position = BasePosition
				Popup.Size = BaseSize
			end

			Popup:GetPropertyChangedSignal("Visible"):Connect(function()
				if not Library.Overlay then
					return
				end
				if Popup.Visible then
					Place()
					Popup.Parent = Library.Overlay
					if not Follow then
						Follow = RunService.RenderStepped:Connect(function()
							if not Anchor.Parent or not IsShown(Anchor) or not InViewport(Anchor) then
								Popup.Visible = false -- fires this handler again -> Restore()
								return
							end
							Place()
						end)
					end
				else
					Restore()
				end
			end)

			Anchor.Destroying:Connect(function()
				if Follow then
					Follow:Disconnect()
					Follow = nil
				end
				Popup:Destroy()
			end)

			table.insert(Library.Popups, Popup)
		end
		--
		function Library:ClosePopups()
			for _, Popup in next, Library.Popups do
				if Popup.Parent and Popup.Visible then
					Popup.Visible = false
				end
			end
		end
		--
		function Library:ChangeAccent(Color)
			Library.Accent = Color
			Library.Theme.Accent = Color

			for obj, theme in next, Library.ThemeObjects do
				if theme:IsA("Frame") or theme:IsA("TextButton") then
					theme.BackgroundColor3 = Color
				elseif theme:IsA("TextLabel") then
					theme.TextColor3 = Color
				elseif theme:IsA("ScrollingFrame") then
					theme.ScrollBarImageColor3 = Color
				end
			end

			Library.UIGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,Color	),ColorSequenceKeypoint.new(1,Library.Theme.Background	)}
		end
		--
		local TextClasses = {TextLabel = true, TextButton = true, TextBox = true}
		local SurfaceRoles = {"Background", "Inline", "Border", "Element", "Section"}
		local BorderRoles = {"Border", "Outline"}
		local GradientRoles = {"Border", "Background", "Inline", "Element"}
		--
		-- Remembers which theme role each colour property of a UI object uses.
		function Library:RegisterThemed(Inst)
			if Library.ThemeSeen[Inst] then
				return
			end
			Library.ThemeSeen[Inst] = true
			if Inst:IsA("UIGradient") then
				Library.ThemeGradients[Inst] = true
				return
			end
			if not Inst:IsA("GuiObject") or Inst:GetAttribute("CrimsonNoTheme") then
				return
			end
			local Registry, Theme = Library.ThemeRegistry, Library.Theme
			for _, Role in ipairs(SurfaceRoles) do
				if Inst.BackgroundColor3 == Theme[Role] then
					Registry[#Registry + 1] = {Inst, "BackgroundColor3", Role}
					break
				end
			end
			for _, Role in ipairs(BorderRoles) do
				if Inst.BorderColor3 == Theme[Role] then
					Registry[#Registry + 1] = {Inst, "BorderColor3", Role}
					break
				end
			end
			if TextClasses[Inst.ClassName] then
				-- text flips between Text and DimText at runtime, so it is resolved when the theme changes
				Registry[#Registry + 1] = {Inst, "TextColor3", "Dynamic"}
				if Inst:IsA("TextBox") and Inst.PlaceholderColor3 == Theme.DimText then
					Registry[#Registry + 1] = {Inst, "PlaceholderColor3", "DimText"}
				end
			end
		end
		--
		-- Library:SetTheme({Background = Color3, Text = Color3, ...}) recolours the whole UI.
		function Library:SetTheme(Changes)
			local Old = table.clone(Library.Theme)
			for Role, Value in next, Changes do
				if Role == "Accent" then
					Library:ChangeAccent(Value)
				elseif Old[Role] ~= nil and typeof(Value) == "Color3" then
					Library.Theme[Role] = Value
				end
			end
			local Theme, Alive = Library.Theme, {}
			for _, Entry in ipairs(Library.ThemeRegistry) do
				local Inst, Property, Role = Entry[1], Entry[2], Entry[3]
				if Inst.Parent then
					Alive[#Alive + 1] = Entry
					if Role == "Dynamic" then
						local Current = Inst[Property]
						if Current == Old.Text then
							Inst[Property] = Theme.Text
						elseif Current == Old.DimText then
							Inst[Property] = Theme.DimText
						end
					elseif Old[Role] ~= Theme[Role] then
						Inst[Property] = Theme[Role]
					end
				end
			end
			Library.ThemeRegistry = Alive
			for Gradient in next, Library.ThemeGradients do
				if Gradient.Parent then
					local Keypoints, Changed = {}, false
					for Index, Keypoint in ipairs(Gradient.Color.Keypoints) do
						local Value = Keypoint.Value
						for _, Role in ipairs(GradientRoles) do
							if Value == Old[Role] and Old[Role] ~= Theme[Role] then
								Value = Theme[Role]
								Changed = true
								break
							end
						end
						Keypoints[Index] = ColorSequenceKeypoint.new(Keypoint.Time, Value)
					end
					if Changed then
						Gradient.Color = ColorSequence.new(Keypoints)
					end
				end
			end
		end
		--
		function Library:SetFont(NewFont)
			local OldFamily = Library.UIFont.Family
			Library.UIFont = NewFont
			if not Library.ScreenGui then
				return
			end
			for _, Inst in ipairs(Library.ScreenGui:GetDescendants()) do
				if TextClasses[Inst.ClassName] and Inst.FontFace.Family == OldFamily then
					Inst.FontFace = NewFont
				end
			end
			task.defer(function()
				for _, Inst in ipairs(Library.ScreenGui:GetDescendants()) do
					if Inst.Name == "Page" and Inst:IsA("TextButton") and Inst:FindFirstChild("Title") then
						Inst.Size = UDim2.new(0, Inst.Title.TextBounds.X + 16, 1, 0)
					end
				end
			end)
		end
		--
		-- One loop drives every colour picker that has Rainbow / Glow / Pulse on.
		function Library:StartPickerLoop()
			if Library.PickerLoop then
				return
			end
			Library.PickerLoop = game:GetService("RunService").RenderStepped:Connect(function()
				local Now = tick()
				for Output in next, Library.AnimatedPickers do
					local Ok, Error = pcall(Output, Now)
					if not Ok then
						Library.AnimatedPickers[Output] = nil
						warn("[Crimson UI] colour effect stopped: " .. tostring(Error))
					end
				end
			end)
		end
		--
		function Library:IsMouseOverFrame(Frame)
			local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize;

			if Mouse.X >= AbsPos.X and Mouse.X <= AbsPos.X + AbsSize.X
				and Mouse.Y >= AbsPos.Y and Mouse.Y <= AbsPos.Y + AbsSize.Y then

				return true;
			end;
		end;
	end

