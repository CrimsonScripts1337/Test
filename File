			local function Output(Now)
				local Colour = hsv
				if Rainbow then
					Colour = Color3.fromHSV((Now * 0.15 * Speed) % 1, sat > 0.05 and sat or 1, val > 0.05 and val or 1)
				end
				if Glow then
					Colour = Colour:Lerp(Color3.new(1, 1, 1), 0.45 * (math.sin(Now * 3 * Speed) + 1) / 2)
				end
				if Pulse then
					Colour = Colour:Lerp(Color3.new(0, 0, 0), 0.6 * (math.sin(Now * 3 * Speed) + 1) / 2)
				end
				Icon.BackgroundColor3 = Colour
